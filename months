#include <iostream>
#include <string>
#include <windows.h>

using namespace std;


int main()
{
	SetConsoleCP(1251);
	SetConsoleOutputCP(1251);

	static const char* MounthsNames[] =
	{
		"Январь","Февраль", "Март", "Апрель", "Май", "Июнь",
		"Июль", "Август", "Сентябрь", "Октябрь", "Декабрь"
	};

	int months;

	while (true)
	{
		std::cout << "Введите номер месяца:";
		std::cin >> months;

		if (months >= 1 && months <= 12)
		{
			std::cout << MounthsNames[months - 1] << std::endl;
		}
		else
		{
			std::cout << "До свидания!" << std::endl;
			break;
		}
	}

	 
	return EXIT_SUCCESS;
}

