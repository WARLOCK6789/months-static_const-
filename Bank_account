#include <iostream>
#include <string>
#include <windows.h>

using namespace std;



struct account
{
	int number;        
	string name;  
	double balance;
};




int main()
{
	SetConsoleCP(1251);
	SetConsoleOutputCP(1251);

	account Bank_account;

	std::cout << "Введите номер счета:" << std::endl;
	std::cin >> Bank_account.number;

	cin.ignore();


	std::cout << "Введите имя владельца:";
	getline(cin, Bank_account.name);


	std::cout << "Введите баланс:" << std::endl;
	std::cin >> Bank_account.balance;


	double new_balance;
	std::cout << "Введите новый баланс:" << std::endl;
	std::cin >> new_balance;

	Bank_account.balance = new_balance;




	std::cout << "Ваш счёт:" << Bank_account.name<<","<< Bank_account.number<<"," << Bank_account.balance << std::endl;




	 
	return EXIT_SUCCESS;
}

