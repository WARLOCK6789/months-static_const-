#include <iostream>
#include <string>
#include <windows.h>

using namespace std;

struct account
{
    int number;
    string name;
    double balance;
};

void changeBalance(account& acc, double newBalance)
{
    acc.balance = newBalance;
}

int main()
{
    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);

    account Bank_account;

    cout << "Введите номер счёта: ";
    cin >> Bank_account.number;

    cin.ignore();

    cout << "Введите имя владельца: ";
    getline(cin, Bank_account.name);

    cout << "Введите баланс: ";
    cin >> Bank_account.balance;

    double new_balance;
    cout << "Введите новый баланс: ";
    cin >> new_balance;

    changeBalance(Bank_account, new_balance);

    cout << "Ваш счёт: " << Bank_account.name << ", " << Bank_account.number << ", " << Bank_account.balance << endl;

    return EXIT_SUCCESS;
}
